# Path to the extracted assignment pack (inputs are read, never modified)
PACK_DIR=/path/to/AI Engineer Freshers - Assignment
DB_PATH=kasparro.db

# Model execution mode: replay | stub | ollama
MODEL_MODE=replay
REPLAY_PATH=replay/qwen2.5-3b_prompt-v1.jsonl
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
MODEL_TIMEOUT_S=60
MODEL_MAX_RETRIES=2
MODEL_MAX_CALLS=200
MODEL_MAX_OUTPUT_CHARS=6000

# Local identities. Role comes from which token is presented, never from the request body.
ANALYST_TOKEN=change-me-analyst
REVIEWER_TOKEN=change-me-reviewer
ANALYST_NAME=analyst@local
REVIEWER_NAME=reviewer@local

# Local demo only: the web page offers an Analyst/Reviewer dropdown instead of pasting tokens.
# Keep false anywhere other people can reach the server.
DEMO_LOGIN=false
